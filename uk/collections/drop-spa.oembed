tock":true},{"title":"Сірий \/ Холодний \/ Немає","offer_id":47717119590724,"sku":"301140409","price":14300.0,"currency_code":"EUR","in_stock":true},{"title":"Сірий \/ Холодний \/ Тільки підключення","offer_id":47718642188612,"sku":"","price":14850.0,"currency_code":"EUR","in_stock":true},{"title":"Сірий \/ Холодний \/ Підключення + краплинна плита","offer_id":47718642221380,"sku":"","price":16850.0,"currency_code":"EUR","in_stock":true},{"title":"Матовий чорний \/ Помірний \/ Немає","offer_id":47717119623492,"sku":"301140558","price":14300.0,"currency_code":"EUR","in_stock":true},{"title":"Матовий чорний \/ Помірний \/ Тільки підключення","offer_id":47718642254148,"sku":"","price":14850.0,"currency_code":"EUR","in_stock":true},{"title":"Матовий чорний \/ Помірний \/ Підключення + краплинна плита","offer_id":47718642286916,"sku":"","price":16850.0,"currency_code":"EUR","in_stock":true},{"title":"Матовий чорний \/ Холодний \/ Немає","offer_id":47717119656260,"sku":"301140559","price":14300.0,"currency_code":"EUR","in_stock":true},{"title":"Матовий чорний \/ Холодний \/ Тільки підключення","offer_id":47718642319684,"sku":"","price":14850.0,"currency_code":"EUR","in_stock":true},{"title":"Матовий чорний \/ Холодний \/ Підключення + краплинна плита","offer_id":47718642352452,"sku":"","price":16850.0,"currency_code":"EUR","in_stock":true}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0556\/0857\/4276\/products\/image_e8d50a4f-d567-47c9-853b-8109307ecff7.jpg?v=1677687026"},{"product_id":"drop-piasara","title":"Drop Pisara","description":"\u003cmeta charset=\"UTF-8\"\u003e\n\n\u003cp\u003e Насолоджуйтесь лазнею на дровах цілий рік!\u003c\/p\u003e\n\n\u003cp\u003e Тема падіння з’являється як у дизайні продуктів, так і в назві компанії. Перші спа-басейни Drop постачалися з плитою, і тоді це був єдиний доступний варіант підігріву. Ось чому цей пакет басейну отримав назву Pisara, що з фінської означає падіння. Все почалося з басейну.\u003c\/p\u003e\n\n \u003cp\u003eСпа-басейн Pisara оснащений неймовірно ефективною та стильною піччю Black Box із часом нагрівання, який пропонують лише найкращі в галузі — приблизно 2 години. Купальник може відчути жар печі, запах колотих дров і атмосферне полум'я за скляними дверцятами печі.\u003c\/p\u003e\n\n\u003cp\u003e Цей басейн покращує традиційну гідромасажну ванну.\u003c\/p\u003e\n\n\u003ch2 data-mce-fragment=\"1\"\u003e Технічні деталі\u003cmeta charset=\"UTF-8\"\u003e\n\n\n\u003c\/h2\u003e\n\n\u003cul\u003e\n\n\u003cli\u003e Кількість осіб: 6–8\u003c\/li\u003e\n\n\u003cli\u003e Довжина сторони: *220 см\u003c\/li\u003e\n\n\u003cli\u003e Внутрішній діаметр: *195 см\u003c\/li\u003e\n\n\u003cli\u003e Висота: *105 см\u003c\/li\u003e\n\n\u003cli\u003e Глибина занурення: прибл. *97 см\u003c\/li\u003e\n\n\u003cli\u003e Вага в порожньому стані: прибл. 240 кг\u003c\/li\u003e\n\n\u003cli\u003e Матеріал: армований пластик\u003c\/li\u003e\n\n\u003cli\u003e Обсяг води: 1830 л\u003c\/li\u003e\n\n\u003cli\u003e Споживання води: 1000–1500 л\u003c\/li\u003e\n\n\u003cli\u003e Вага печі: прибл. 40 кг\u003c\/li\u003e\n\n\n\u003c\/ul\u003e\n\n\u003cp\u003e\u003c\/p\u003e\n\n\u003cp\u003e +\/- 0,5 см\u003c\/p\u003e\n\n\u003ch2 data-mce-fragment=\"1\"\u003e \u003cspan style=\"font-size: 1.4em;\"\u003eВміст комплекту басейну\u003c\/span\u003e\n\u003c\/h2\u003e\n\n\u003cp\u003e У пакет входить все необхідне для використання традиційного басейну з дров'яною піччю.\u003c\/p\u003e\n\n\u003cul\u003e\n\n\u003cli\u003e Спа-басейн у білому, сірому або чорному кольорах\u003c\/li\u003e\n\n\u003cli\u003e Дерев'яний каркас для басейну, оброблений тиском\u003c\/li\u003e\n\n\u003cli\u003e Піч Black Box потужністю 35 кВт\u003c\/li\u003e\n\n\u003cli\u003e Димохід і захисна решітка\u003c\/li\u003e\n\n\u003cli\u003e Лопата для ясеня\u003c\/li\u003e\n\n\u003cli\u003e Світлодіодний світильник для басейну\u003c\/li\u003e\n\n\u003cli data-stringify-indent=\"0\"\u003e Ізоляційне покриття\u003c\/li\u003e\n\n\u003cli\u003e Всі необхідні шланги та хомути для плити. \u003c\/li\u003e\n\n\n\u003c\/ul\u003e\n\n\u003cp\u003e\u003c\/p\u003e\n\n\u003cdiv id=\"teknisettiedot\" class=\"tab panel cpadding-s\"\u003e\n\n\u003carticle class=\"col-full\"\u003e\n\u003cdiv id=\"solu129501\"\u003e\n\n\u003cdiv id=\"sisalto\" class=\"tab panel cpadding-s\"\u003e\n\n\u003carticle class=\"col-full\"\u003e\n\u003cdiv id=\"solu129511\"\u003e\u003c\/div\u003e\n\n\u003c\/article\u003e\n\n\u003c\/div\u003e\n\n\n\u003c\/div\u003e\n\n\u003c\/article\u003e\n\n\u003c\/div\u003e","brand":"Drop","offers":[{"title":"чорний","offer_id":44553776628036,"sku":"","price":9000.0,"currency_code":"EUR","in_stock":true},{"title":"Білий","offer_id":44553776660804,"sku":"","price":9000.0,"currency_code":"EUR","in_stock":true},{"title":"Сірий","offer_id":44553776693572,"sku":"","price":9000.0,"currency_code":"EUR","in_stock":true},{"title":"Матовий чорний","offer_id":47718763430212,"sku":"","price":9000.0,"currency_code":"EUR","in_stock":true}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0556\/0857\/4276\/products\/image_249a98b9-de06-4724-aaef-ab2e0d487e7a.jpg?v=1677687045"},{"product_id":"drop-lampi-compact","title":"Drop Lampi Compact","description":"\u003cmeta charset=\"UTF-8\"\u003e\n\n\u003cp data-mce-fragment=\"1\"\u003e Така ж розкіш у меншому розмірі. Серія Drop Compact пропонує ідеальне поєднання розкоші та відпочинку для невеликих приміщень.\u003c\/p\u003e\n\n\u003cp data-mce-fragment=\"1\"\u003e\u003c\/p\u003e\n\n\u003cp data-mce-fragment=\"1\"\u003e Завдяки масажним сидінням на 3 і 24 масажних форсунки Drop Vuolle Compact забезпечує такі ж враження, як і наші флагманські моделі, але в меншій комплектації, але без шкоди для нашого фірмового дизайну та поєднання функцій і адаптивності.\u003c\/p\u003e\n\n\u003cp data-mce-fragment=\"1\"\u003e\u003c\/p\u003e\n\n\u003cp data-mce-fragment=\"1\"\u003e Як і всі спа-салони Drop, Drop Lampi Compact також можна повністю або частково вбудувати, щоб ідеально підійти до вашої тераси чи патіо. Або ви можете встановити його поверх вашої тераси, а з боків обшити гарною панеллю.\u003c\/p\u003e\n\n\u003cp data-mce-fragment=\"1\"\u003e\u003c\/p\u003e\n\n\u003cdiv class=\"accordion tablinks active\" hidden=\"\"\u003e\n\n\u003ch5\u003eТЕХНІЧНІ ДЕТАЛІ \u003c\/h5\u003e\n\n\n\u003c\/div\u003e\n\n\u003cdiv class=\"tab panel cpadding-s\" id=\"teknisettiedot\"\u003e\n\n\u003carticle class=\"col-full\"\u003e\n\u003cdiv id=\"solu129501\"\u003e\n\n\u003cp\u003e Технічні деталі\u003c\/p\u003e\n\n\u003cul\u003e\n\n\u003cli\u003e Місткість: 3-4 чол\u003c\/li\u003e\n\n\u003cli\u003e Довжина сторони: *190 см\u003c\/li\u003e\n\n\u003cli\u003e Внутрішній діаметр: *171 см\u003c\/li\u003e\n\n\u003cli\u003e Висота: *105,0 см\u003c\/li\u003e\n\n\u003cli\u003e Глибина занурення: *97 см\u003c\/li\u003e\n\n\u003cli\u003e Ємність води: 1500 л\u003c\/li\u003e\n\n\u003cli\u003e Споживання води: 900-1200 л\u003c\/li\u003e\n\n\u003cli\u003e Матеріал: акрил \/ армований пластик\u003c\/li\u003e\n\n\u003cli\u003e Вага в порожньому стані: прибл. 250 кг\u003c\/li\u003e\n\n\u003cli\u003e Електричне підключення: 3 x 16 A, 400V\u003cbr\u003e\u003cbr\u003e +\/- 0,5 см\u003c\/li\u003e\n\n\n\u003c\/ul\u003e\n\n\u003cp\u003e Вміст комплекту басейну\u003c\/p\u003e\n\n\u003cdiv class=\"accordion tablinks active\" hidden=\"\"\u003e\n\n\u003ch5\u003e ВМІСТ ПАКЕТУ БАСЕЙНУ \u003c\/h5\u003e\n\n\n\u003c\/div\u003e\n\n\u003cdiv class=\"tab panel cpadding-s\" id=\"sisalto\"\u003e\n\n\u003carticle class=\"col-full\"\u003e\n\u003cdiv id=\"solu129511\"\u003e\n\n\u003cul\u003e\n\n\u003cli\u003e Падаючий гідромасажний басейн\u003c\/li\u003e\n\n\u003cli\u003e Алюмінієва рама\u003c\/li\u003e\n\n \u003cli\u003eЕлектроопалення 3 кВт (6 кВт у Фінляндії, Швеції та Норвегії)\u003c\/li\u003e\n\n\u003cli\u003e Система фільтрації\u003c\/li\u003e\n\n\u003cli\u003e Світлодіодний світильник для басейну\u003c\/li\u003e\n\n\u003cli\u003e 30 мм поліуретанова ізоляція всієї рами (50 мм у Фінляндії, Швеції та Норвегії)\u003c\/li\u003e\n\n\u003cli\u003e Ізоляційна кришка\u003c\/li\u003e\n\n\u003cli\u003e УФ система\u003c\/li\u003e\n\n\u003cli\u003e Система озонування\u003c\/li\u003e\n\n\u003cli\u003e Стартовий набір хімії для басейну\u003c\/li\u003e\n\n\n\u003c\/ul\u003e\n\n\u003cp\u003e Технологія басейну збирається і перевіряється на воді на заводі. \u003c\/p\u003e\n\n\u003cp\u003e\u003c\/p\u003e\n\n\n\u003c\/div\u003e\n\n\u003c\/article\u003e\n\n\u003c\/div\u003e\n\n\n\u003c\/div\u003e\n\n\u003c\/article\u003e\n\n\u003c\/div\u003e","brand":"Drop","offers":[{"title":"чорний \/ Холодний","offer_id":47718722535748,"sku":"301250509","price":11500.0,"currency_code":"EUR","in_stock":true},{"title":"чорний \/ Помірний","offer_id":47718722568516,"sku":"301250508","price":11500.0,"currency_code":"EUR","in_stock":true},{"title":"Білий \/ Холодний","offer_id":47718722601284,"sku":"301250209","price":11500.0,"currency_code":"EUR","in_stock":true},{"title":"Білий \/ Помірний","offer_id":47718722634052,"sku":"301250208","price":11500.0,"currency_code":"EUR","in_stock":true},{"title":"Сірий \/ Холодний","offer_id":47718722666820,"sku":"301250409","price":11500.0,"currency_code":"EUR","in_stock":true},{"title":"Сірий \/ Помірний","offer_id":47718722699588,"sku":"301250408","price":11500.0,"currency_code":"EUR","in_stock":true},{"title":"Матовий чорний \/ Холодний","offer_id":47718722732356,"sku":"301250559","price":11500.0,"currency_code":"EUR","in_stock":true},{"title":"Матовий чорний \/ Помірний","offer_id":47718722765124,"sku":"301250558","price":11500.0,"currency_code":"EUR","in_stock":true}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0556\/0857\/4276\/files\/Drop_design-spa-rooftop-4-1-_309_368_670404e9-88c3-47e5-b1e9-02615f7bab0a.jpg?v=1704307422"}],"url":"https:\/\/heatica.com\/uk\/collections\/drop-spa.oembed","provider":"Heatica","version":"1.0","type":"link"}